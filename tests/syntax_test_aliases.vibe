# generic-free aliases with structured right-hand sides

type id = int
#    ^ entity.name.type
type ids = array<id>
#    ^ entity.name.type
type record = { id: id, ... }
#    ^ entity.name.type
type pair = [id, string]
#    ^ entity.name.type
type maybe = id | nil
#    ^ entity.name.type
items: ids = [1]
#      ^ meta.annotation.type support.type
entry: record = { id: 1 }
#      ^ meta.annotation.type support.type
tuple: pair = [1, "one"]
#      ^ meta.annotation.type support.type
optional: maybe = nil
#         ^ meta.annotation.type support.type
# qualified lowercase aliases

module Types
  type id = int
# ^ keyword.declaration.type
#      ^ entity.name.type
end
value: Types::id = 1
# <- variable.other - constant.other.symbol
#      ^ meta.annotation.type support.class
#             ^ meta.annotation.type support.type
# lowercase aliases in block annotations

type id = int
type text = string
values: array<int | string> = [1, "two"]
values.each { |value: id | text| puts value }
#                     ^ meta.annotation.type support.type
#                          ^ meta.annotation.type support.type
#                        ^ keyword.operator.union
#                              ^ punctuation.separator.block-parameters.end
#                                ^ source.vibescript - meta.annotation.type - meta.block.parameters
def visit(&block: id -> id) -> id
#                 ^ meta.annotation.type support.type
  yield 1
end
# optional alias annotation

type id = int
value: id? = nil
# <- variable.other - constant.other.symbol
#      ^ meta.annotation.type support.type
#        ^ keyword.operator.optional
#            ^ constant.language.null - meta.annotation.type
# semicolon aliases and trailing comments

type id=int; type label=string # aliases
#    ^ entity.name.type
#       ^ meta.annotation.type support.type
#                 ^ entity.name.type
#                       ^ meta.annotation.type support.type
#                              ^ comment.line
value: id = 1
# <- variable.other - constant.other.symbol
name: label = "one"
# <- variable.other - constant.other.symbol
puts name
#    ^ source.vibescript - meta.annotation.type
