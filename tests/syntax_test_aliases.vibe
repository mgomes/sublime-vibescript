# SYNTAX TEST "Packages/Vibescript/Vibescript.sublime-syntax"
# alias name id

type id = int # alias
# <- keyword.declaration.type
#    ^ entity.name.type
#         ^ meta.annotation.type support.type
#               ^ comment.line
value: id = 1
# <- variable.other - constant.other.symbol
#      ^ meta.annotation.type support.type
#           ^ constant.numeric - meta.annotation.type
def echo(item: id) -> id
#              ^ meta.annotation.type support.type
#                     ^ meta.annotation.type support.type
  item
# ^ source.vibescript - meta.annotation.type
end
echo(value)
