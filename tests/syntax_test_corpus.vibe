def word_wrap(text: string, width: int) -> array<string>
#   ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#             ^ variable.parameter
#                   ^ meta.annotation.type support.type
#                           ^ variable.parameter
#                                  ^ meta.annotation.type support.type
#                                          ^ meta.annotation.type support.type
#                                                ^ meta.annotation.type support.type
  words = text.split
# ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#         ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#              ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
