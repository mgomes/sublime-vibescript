#                                                 ^ meta.annotation.type support.type
#                                                         ^ meta.annotation.type support.class
#                                                                    ^ meta.annotation.type support.type
#                                                                          ^ meta.annotation.type support.type
  orders.filter_map { |order|
# ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#        ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#                     ^ punctuation.separator.block-parameters.begin
#                      ^ variable.parameter
#                           ^ punctuation.separator.block-parameters.end
    item = stock[order["sku"]]
#   ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#          ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#                ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#                       ^ string.quoted.double
    if item != nil && item["available"] >= order["quantity"]
#      ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#                     ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#                           ^ string.quoted.double
