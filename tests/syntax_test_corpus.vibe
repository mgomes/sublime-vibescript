type Stock = { available: int, warehouse: string }
#                         ^ meta.annotation.type support.type
#                                         ^ meta.annotation.type support.type
type Order = { sku: string, quantity: int }
#                   ^ meta.annotation.type support.type
#                                     ^ meta.annotation.type support.type
def fulfillable(orders: array<Order>, stock: hash<string, Stock>) -> array<string>
#   ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#               ^ variable.parameter
#                       ^ meta.annotation.type support.type
#                             ^ meta.annotation.type support.class
#                                     ^ variable.parameter
