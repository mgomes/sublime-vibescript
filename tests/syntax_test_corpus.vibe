def test_money_invoice
#   ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
  subject = require("money_invoice")
# ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#                    ^ string.quoted.double
  assert subject.invoice([{ unit: money("1.25 USD"), quantity: 3 }], "USD") == '{"cents":375,"currency":"USD","display":"3.75 USD"}'
# ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
#        ^ source.vibescript - meta.annotation.type - meta.block.parameters - string - comment
