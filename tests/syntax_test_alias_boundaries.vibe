#          ^^^ - meta.annotation.type

type box<T> = array<T>
# <- - keyword.declaration.type
#    ^^^ - entity.name.type
#        ^ - meta.annotation.type

def p<T>(value: T)
#     ^ - meta.annotation.type - variable.parameter
end

opts = { value: id }
#        ^^^^^ constant.other.symbol - meta.annotation.type
#               ^^ - meta.annotation.type
opts = {
  value: id
# ^^^^^ constant.other.symbol - meta.annotation.type
#        ^^ - meta.annotation.type
}
