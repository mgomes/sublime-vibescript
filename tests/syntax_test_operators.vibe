# SYNTAX TEST "Packages/Vibescript/Vibescript.sublime-syntax"
# inline operator:+

value = 9 + 2
#         ^ keyword.operator.arithmetic
# inline operator:-

value = 9 - 2
#         ^ keyword.operator.arithmetic
# inline operator:*

value = 9 * 2
#         ^ keyword.operator.arithmetic
# inline operator:**

value = 9 ** 2
#         ^ keyword.operator.arithmetic
#          ^ keyword.operator.arithmetic
# inline operator:/

value = 9 / 2
#         ^ keyword.operator.arithmetic
# inline operator://

value = 9 // 2
#         ^ keyword.operator.arithmetic
#          ^ keyword.operator.arithmetic
# inline operator:%

value = 9 % 2
#         ^ keyword.operator.arithmetic
# inline operator:==

value = 9 == 2
#         ^ keyword.operator.comparison
#          ^ keyword.operator.comparison
# inline operator:===

value = 9 === 2
#         ^ keyword.operator.comparison
#          ^ keyword.operator.comparison
#           ^ keyword.operator.comparison
# inline operator:!=

value = 9 != 2
#         ^ keyword.operator.comparison
#          ^ keyword.operator.comparison
# inline operator:<

value = 9 < 2
#         ^ keyword.operator.comparison
# inline operator:<=

value = 9 <= 2
#         ^ keyword.operator.comparison
#          ^ keyword.operator.comparison
# inline operator:>

value = 9 > 2
#         ^ keyword.operator.comparison
# inline operator:>=

value = 9 >= 2
#         ^ keyword.operator.comparison
#          ^ keyword.operator.comparison
# inline operator:<=>

value = 9 <=> 2
#         ^ keyword.operator.comparison
#          ^ keyword.operator.comparison
#           ^ keyword.operator.comparison
# inline operator:=~

value = "abc" =~ /a/
#             ^ keyword.operator.match
#              ^ keyword.operator.match
# inline operator:!~

value = "abc" !~ /a/
#             ^ keyword.operator.match
#              ^ keyword.operator.match
# inline operator:&&

value = true && false
#            ^ keyword.operator.logical
#             ^ keyword.operator.logical
# inline operator:||

value = true || false
#            ^ keyword.operator.logical
#             ^ keyword.operator.logical
# inline operator:<<

value = [1] << 2
#           ^ keyword.operator.bitwise
#            ^ keyword.operator.bitwise
# inline operator:&

value = [1, 2] & [2, 3]
#              ^ keyword.operator.bitwise
# inline operator:..

value = 1 .. 3
#         ^ keyword.operator.range
#          ^ keyword.operator.range
# inline operator:...

value = 1 ... 3
#         ^ keyword.operator.range
#          ^ keyword.operator.range
#           ^ keyword.operator.range
# operator symbol:!

