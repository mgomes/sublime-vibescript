<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Indentation Rules</string>
	<key>scope</key>
	<string>source.vibescript</string>
	<key>settings</key>
	<dict>
		<key>decreaseIndentPattern</key>
		<string>^\s*(?:[}\]]|(end|elsif|else|when|rescue|ensure)\b)</string>
		<key>increaseIndentPattern</key>
		<string>^\s*(?:(export\s+)?((private|public|protected)\s+)?def|class|module|enum|if|elsif|else|while|for|case|when|begin|rescue|ensure)\b|^(?!\s*=(?:begin|end)\b)(?:"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|(?&lt;![\w)\]}"/])/(?![\s=/])(?:\\.|\[(?:\\.|[^\]\\])*\]|[^/\\\n])+/[a-z]*|[^#"'\\])*[\[{]\s*(?:\|[^|]*\|\s*)?(?:#.*)?$</string>
	</dict>
</dict>
</plist>
